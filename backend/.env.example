# Primary provider: gemini or groq. The other one is used as an automatic fallback
# when its API key and model are both set.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# A Gemini 3 Flash-class model. Gemini 1.x/2.0/2.5 ids are rejected at startup.
# Alternatives: gemini-3.6-flash, gemini-3-flash-preview
LLM_MODEL=gemini-3.8-flash
# Last-resort backup with its own free quota (the main model only gets ~20 requests a day).
# Leave empty to turn it off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Must support strict structured outputs: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Only this origin is allowed by CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=5

# Accounts and history (optional). All of these come from `neon env pull` in the repo root
# (written to .env.local). Leave them empty to run without sign-in and saved history.
# Neon Postgres (pooled connection string)
DATABASE_URL=
# Neon Auth: used to verify the JWTs the frontend sends
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon object storage (S3-compatible) for the uploaded resume files
STORAGE_BUCKET=cv-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
