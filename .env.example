# Reference of every environment variable. Copy the per-app templates instead:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local

# Backend (FastAPI on Render)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=5
# Accounts and history (optional; values come from `neon env pull`)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
STORAGE_BUCKET=cv-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Frontend (Next.js on Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only; same NEON_AUTH_BASE_URL as the backend
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
