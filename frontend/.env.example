# Base URL of the FastAPI backend, without a trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site, used for canonical links, Open Graph images, sitemap.xml and robots.txt.
# Optional on Vercel (defaults to the production domain); set it when you use a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Auth (server-only). The Auth URL comes from `neon env pull` or the Neon Console
# (Branch > Auth > Configuration). Generate the secret with `openssl rand -base64 32`.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
